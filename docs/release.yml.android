name: Release

# GitHub 웹에서 Actions 탭 → Release → Run workflow 버튼만 누르면
# 버전 인상 → 서명 빌드 → 태그 → 릴리즈 등록까지 한 번에 끝납니다.
on:
  workflow_dispatch:
    inputs:
      bump:
        description: "올릴 자리"
        required: true
        default: patch
        type: choice
        options: [patch, minor, major]
      notes:
        description: "릴리즈 노트 (비워두면 CHANGELOG.md의 [미출시] 내용을 사용)"
        required: false
        default: ""

permissions:
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: 버전 인상
        id: ver
        run: |
          python3 - <<'PY'
          import os, re
          path = "version.properties"
          raw = open(path, encoding="utf-8").read()
          def get(k):
              return int(re.search(rf"^{k}=(\d+)$", raw, re.M).group(1))
          maj, mnr, pch, code = get("versionMajor"), get("versionMinor"), get("versionPatch"), get("versionCode")
          bump = "${{ github.event.inputs.bump }}"
          if bump == "major":   maj, mnr, pch = maj + 1, 0, 0
          elif bump == "minor": mnr, pch = mnr + 1, 0
          else:                 pch += 1
          code += 1
          for k, v in [("versionMajor", maj), ("versionMinor", mnr), ("versionPatch", pch), ("versionCode", code)]:
              raw = re.sub(rf"^{k}=\d+$", f"{k}={v}", raw, flags=re.M)
          open(path, "w", encoding="utf-8").write(raw)
          name = f"{maj}.{mnr}.{pch}"
          with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as f:
              f.write(f"name={name}\ncode={code}\ntag=v{name}\n")
          print(f"→ {name} (versionCode {code})")
          PY

      - name: 변경 이력 정리
        id: log
        run: |
          python3 - <<'PY'
          import os, re, datetime
          path, tag = "CHANGELOG.md", "${{ steps.ver.outputs.name }}"
          raw = open(path, encoding="utf-8").read()
          m = re.search(r"## \[미출시\]\n(.*?)(?=\n## |\Z)", raw, re.S)
          body = (m.group(1).strip() if m else "")
          if not body:
              body = "- 내부 개선"
          today = datetime.date.today().isoformat()
          raw = raw.replace(m.group(0), f"## [미출시]\n\n") if m else raw
          raw = raw.replace("## [미출시]\n\n",
                            f"## [미출시]\n\n---\n\n## 앱 {tag} — {today}\n\n{body}\n\n", 1)
          open(path, "w", encoding="utf-8").write(raw)
          with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as f:
              f.write("notes<<EOF\n" + body + "\nEOF\n")
          PY

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
          cache: gradle

      - name: 키스토어 복원
        env:
          KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
        run: |
          if [ -z "$KEYSTORE_BASE64" ]; then
            echo "::error::KEYSTORE_BASE64 시크릿이 없습니다. Settings → Secrets → Actions에서 등록하십시오."
            exit 1
          fi
          echo "$KEYSTORE_BASE64" | base64 -d > app/release.jks
          echo "키스토어 복원 완료 ($(stat -c%s app/release.jks) bytes)"

      - name: 서명 빌드
        env:
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: |
          chmod +x gradlew
          ./gradlew --no-daemon bundleRelease assembleRelease

      - name: 서명 검증
        run: |
          APK=$(find app/build/outputs/apk/release -name "*.apk" | head -1)
          "$ANDROID_HOME"/build-tools/34.0.0/apksigner verify --print-certs "$APK"

      - name: 산출물 이름 정리
        run: |
          mkdir -p dist
          cp "$(find app/build/outputs/bundle/release -name '*.aab' | head -1)" \
             "dist/mungae-american-${{ steps.ver.outputs.name }}.aab"
          cp "$(find app/build/outputs/apk/release -name '*.apk' | head -1)" \
             "dist/mungae-american-${{ steps.ver.outputs.name }}.apk"
          ls -lh dist

      - name: 버전 커밋 및 태그
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add version.properties CHANGELOG.md
          git commit -m "release: ${{ steps.ver.outputs.tag }} (versionCode ${{ steps.ver.outputs.code }})"
          git tag ${{ steps.ver.outputs.tag }}
          git push origin HEAD:${{ github.ref_name }} --follow-tags

      - name: 릴리즈 등록
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ steps.ver.outputs.tag }}
          name: 멍개미국어 ${{ steps.ver.outputs.name }}
          body: ${{ github.event.inputs.notes || steps.log.outputs.notes }}
          files: dist/*

      - name: 키스토어 삭제
        if: always()
        run: rm -f app/release.jks
